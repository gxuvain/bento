		"drizzle-orm": "^0.44.7",
		"drizzle-zod": "^0.8.3",
		"nuxt": "^4.2.1",
		"vue": "^3.5.25",
		"vue-router": "^4.6.3",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.7",
		"husky": "^9.1.7",
